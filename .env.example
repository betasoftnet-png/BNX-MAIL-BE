# ==========================================
# BNXmail Backend Environment Configuration
# ==========================================

# --- Database Configuration ---
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mail_app_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=mailuser
# SPRING_DATASOURCE_PASSWORD=StrongPassword

# --- JWT Configuration ---
# JWT_SECRET=your-256-bit-secret-key-goes-here-min-32-chars
# JWT_EXPIRATION=900000

# --- SMTP Configuration (Email OTP & Notifications) ---
# Supports standard SPRING_MAIL_* and SMTP_* variable names
# Provider Examples:
#   Hostinger: host=smtp.hostinger.com, port=465 (ssl=true) or 587 (starttls=true)
#   AWS SES:   host=email-smtp.us-east-1.amazonaws.com, port=587 (starttls=true)
#   Gmail:     host=smtp.gmail.com, port=587 (starttls=true) or 465 (ssl=true)
#   SendGrid:  host=smtp.sendgrid.net, port=587, username=apikey
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply@bnxmail.com
SPRING_MAIL_PASSWORD=your-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=*
MAIL_FROM=noreply@bnxmail.com

# --- MSG91 Configuration (Phone SMS OTP) ---
# Obtain from MSG91 dashboard (https://control.msg91.com/)
SMS_PROVIDER_AUTHKEY=your_msg91_auth_key
SMS_PROVIDER_FORGOTPASSWORDTEMPLATEID=your_msg91_flow_template_id
SMS_PROVIDER_SENDERID=BNXML

